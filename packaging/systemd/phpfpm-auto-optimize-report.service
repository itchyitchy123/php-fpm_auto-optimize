[Unit]
Description=Report PHP-FPM capacity recommendations
Documentation=man:phpfpm-auto-optimize(8)

[Service]
Type=oneshot
ExecStart=/usr/sbin/phpfpm-auto-optimize --check
SuccessExitStatus=2
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/phpfpm-auto-optimize
