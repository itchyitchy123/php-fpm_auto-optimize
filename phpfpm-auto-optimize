#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM=${0##*/}
VERSION="0.3.0"
APPLY=0
ASSUME_YES=0
VERBOSE=0
MEMORY_MB=""
RESERVE_PERCENT=20
TARGET_PERCENT=80
FALLBACK_WORKER_MB=64
MIN_WORKER_MB=48
MIN_CHILDREN=5
MAX_CHILDREN_CAP=75
CHANGE_PERCENT=20
LOOKBACK_HOURS=48
HOT_WARNINGS=2
VERY_HOT_WARNINGS=5
MAX_REQUESTS_CAP=500
POOL_DIRS=()
LOG_FILES=()
BACKUP_ROOT="/var/backups/phpfpm-auto-optimize"
RUN_ID=$(date +%Y%m%d-%H%M%S)

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
debug() { (( VERBOSE )) && printf '[DEBUG] %s\n' "$*" >&2 || :; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
is_uint() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

usage() {
  cat <<EOF
PHP-FPM auto-optimizer $VERSION

Usage: $PROGRAM [options]

  --apply                 Write overrides, validate, and restart/reload PHP-FPM
  --yes                   Do not prompt before applying
  --verbose, -v           Show diagnostics
  --memory-mb N           Override detected RAM
  --reserve-percent N     RAM kept outside the calculation (default: 20)
  --target-percent N      Remaining RAM available to FPM (default: 80)
  --worker-mb N           Fallback worker size (default: 64)
  --pool-dir PATH         Limit discovery to a pool directory (repeatable)
  --log-file PATH         Add a PHP-FPM error log (repeatable)
  --backup-dir PATH       Backup root
  --version               Print version
  -h, --help              Show help

Default mode is a dry run.
EOF
}

while (($#)); do
  case $1 in
    --apply) APPLY=1 ;;
    --yes) ASSUME_YES=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    --memory-mb|--reserve-percent|--target-percent|--worker-mb|--pool-dir|--log-file|--backup-dir)
      (($# >= 2)) || die "$1 requires a value"
      case $1 in
        --memory-mb) MEMORY_MB=$2 ;;
        --reserve-percent) RESERVE_PERCENT=$2 ;;
        --target-percent) TARGET_PERCENT=$2 ;;
        --worker-mb) FALLBACK_WORKER_MB=$2 ;;
        --pool-dir) POOL_DIRS+=("$2") ;;
        --log-file) LOG_FILES+=("$2") ;;
        --backup-dir) BACKUP_ROOT=$2 ;;
      esac
      shift ;;
    --version) log "$PROGRAM $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

for value in "$RESERVE_PERCENT" "$TARGET_PERCENT" "$FALLBACK_WORKER_MB"; do
  is_uint "$value" || die "numeric options must be non-negative integers"
done
(( RESERVE_PERCENT < 100 && TARGET_PERCENT > 0 && TARGET_PERCENT <= 100 && FALLBACK_WORKER_MB > 0 )) ||
  die "invalid percentage or worker size"
[[ -z $MEMORY_MB ]] || { is_uint "$MEMORY_MB" && (( MEMORY_MB > 0 )); } || die "invalid --memory-mb"

[[ -n $MEMORY_MB ]] || MEMORY_MB=$(awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo)
is_uint "$MEMORY_MB" && (( MEMORY_MB > 0 )) || die "could not determine system memory"

discover_dirs() {
  local candidates=() dir
  if ((${#POOL_DIRS[@]})); then
    candidates=("${POOL_DIRS[@]}")
  else
    shopt -s nullglob
    candidates+=(/opt/cpanel/ea-php*/root/etc/php-fpm.d /etc/php/*/fpm/pool.d)
    candidates+=(/etc/php-fpm.d /etc/opt/remi/php*/php-fpm.d /usr/local/etc/php-fpm.d)
    shopt -u nullglob
  fi
  for dir in "${candidates[@]}"; do [[ -d $dir ]] && printf '%s\n' "$dir"; done | awk '!seen[$0]++'
}

mapfile -t FOUND_DIRS < <(discover_dirs)
((${#FOUND_DIRS[@]})) || die "no PHP-FPM pool directories found; use --pool-dir PATH"

# Parse assignments in load order. Repeated pool sections merge directive by
# directive, which mirrors PHP-FPM and avoids inventing defaults for overlays.
declare -A BASE_CHILD=() BASE_REQUESTS=() EFFECTIVE_CHILD=() EFFECTIVE_REQUESTS=() POOL_EXISTS=()
declare -a POOL_KEYS=()
parse_file() {
  local file=$1 dir=$2 layer=$3 pool="" line key value
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}; line=${line%"${line##*[![:space:]]}"}
    [[ -z $line || $line == \;* || $line == \#* ]] && continue
    if [[ $line =~ ^\[([^]]+)\]$ ]]; then pool=${BASH_REMATCH[1]}; continue; fi
    [[ -n $pool && $pool != global ]] || continue
    key="$dir|$pool"
    if [[ -z ${POOL_EXISTS[$key]+x} ]]; then POOL_EXISTS[$key]=1; POOL_KEYS+=("$key"); fi
    if [[ $line =~ ^pm\.max_children[[:space:]]*=[[:space:]]*([0-9]+) ]]; then
      value=${BASH_REMATCH[1]}; [[ $layer == baseline ]] && BASE_CHILD[$key]=$value; EFFECTIVE_CHILD[$key]=$value
    elif [[ $line =~ ^pm\.max_requests[[:space:]]*=[[:space:]]*([0-9]+) ]]; then
      value=${BASH_REMATCH[1]}; [[ $layer == baseline ]] && BASE_REQUESTS[$key]=$value; EFFECTIVE_REQUESTS[$key]=$value
    fi
  done < "$file"
}

for dir in "${FOUND_DIRS[@]}"; do
  while IFS= read -r file; do
    [[ ${file##*/} == zzz-auto-optimize.conf ]] && continue
    parse_file "$file" "$dir" baseline
  done < <(find "$dir" -maxdepth 1 -type f -name '*.conf' -print | sort)
  [[ ! -f $dir/zzz-auto-optimize.conf ]] || parse_file "$dir/zzz-auto-optimize.conf" "$dir" effective
done

declare -a ACTIVE_KEYS=()
for key in "${POOL_KEYS[@]}"; do
  [[ -n ${BASE_CHILD[$key]:-} ]] || continue
  EFFECTIVE_CHILD[$key]=${EFFECTIVE_CHILD[$key]:-${BASE_CHILD[$key]}}
  BASE_REQUESTS[$key]=${BASE_REQUESTS[$key]:-500}
  EFFECTIVE_REQUESTS[$key]=${EFFECTIVE_REQUESTS[$key]:-${BASE_REQUESTS[$key]}}
  ACTIVE_KEYS+=("$key")
done
((${#ACTIVE_KEYS[@]})) || die "no pools with pm.max_children found"

declare -a RSS_VALUES=()
while read -r rss args; do
  is_uint "$rss" || continue
  [[ $args == *"php-fpm: pool "* && $args != *"master process"* ]] || continue
  RSS_VALUES+=("$(( (rss + 1023) / 1024 ))")
done < <(ps -eo rss=,args= 2>/dev/null)

WORKER_MB=$FALLBACK_WORKER_MB; RSS_SOURCE="fallback"
if ((${#RSS_VALUES[@]} >= 5)); then
  mapfile -t SORTED_RSS < <(printf '%s\n' "${RSS_VALUES[@]}" | sort -n)
  idx=$(( (${#SORTED_RSS[@]} * 75) / 100 )); (( idx < ${#SORTED_RSS[@]} )) || idx=$((${#SORTED_RSS[@]} - 1))
  WORKER_MB=${SORTED_RSS[$idx]}; RSS_SOURCE="observed p75"
fi
if (( WORKER_MB < MIN_WORKER_MB )); then WORKER_MB=$MIN_WORKER_MB; RSS_SOURCE="$RSS_SOURCE, floored"; fi

RESERVED_MB=$(( MEMORY_MB * RESERVE_PERCENT / 100 ))
FPM_BUDGET_MB=$(( (MEMORY_MB - RESERVED_MB) * TARGET_PERCENT / 100 ))
SAFE_CHILDREN=$(( FPM_BUDGET_MB / WORKER_MB ))
(( SAFE_CHILDREN > 0 )) || die "calculated worker capacity is zero"

if ((${#LOG_FILES[@]} == 0)); then
  shopt -s nullglob
  LOG_FILES+=(/opt/cpanel/ea-php*/root/usr/var/log/php-fpm/error.log)
  LOG_FILES+=(/opt/cpanel/ea-php*/root/usr/var/log/php-fpm.log /var/log/php-fpm/error.log /var/log/php-fpm/www-error.log)
  shopt -u nullglob
fi
declare -A WARNINGS=()
CUTOFF_EPOCH=$(date -d "$LOOKBACK_HOURS hours ago" +%s)
for file in "${LOG_FILES[@]}"; do
  [[ -f $file ]] || { debug "log not found: $file"; continue; }
  while IFS= read -r line; do
    [[ $line == *max_children* && $line =~ \[pool[[:space:]]+([^]]+)\] ]] || continue
    pool=${BASH_REMATCH[1]}
    [[ $line =~ ^\[([^]]+)\] ]] || continue
    epoch=$(date -d "${BASH_REMATCH[1]}" +%s 2>/dev/null || printf 0)
    (( epoch >= CUTOFF_EPOCH )) || continue
    WARNINGS[$pool]=$(( ${WARNINGS[$pool]:-0} + 1 ))
  done < "$file"
done

percent_diff() {
  local a=$1 b=$2 d
  d=$((b-a)); ((d<0)) && d=$((-d))
  ((a>0)) && echo $((d*100/a)) || echo 100
}
declare -A PROPOSED_CHILD=() PROPOSED_REQUESTS=() REASON=() DESIRED=()
TOTAL_PROPOSED=0; CHANGES=0
for key in "${ACTIVE_KEYS[@]}"; do
  dir=${key%%|*}; pool=${key#*|}; base=${BASE_CHILD[$key]}; current=${EFFECTIVE_CHILD[$key]}; warnings=${WARNINGS[$pool]:-0}
  proposed=$base; reason="baseline"
  if (( warnings >= VERY_HOT_WARNINGS )); then proposed=$(( (base * 125 + 99) / 100 )); reason="hot:$warnings warnings"
  elif (( warnings >= HOT_WARNINGS )); then proposed=$(( (base * 110 + 99) / 100 )); reason="busy:$warnings warnings"
  elif (( warnings == 1 )); then proposed=$base; reason="protect:recent warning"
  else proposed=$(( (base * 80 + 99) / 100 )); reason="quiet:conservative reduction"
  fi
  (( proposed < MIN_CHILDREN )) && proposed=$MIN_CHILDREN
  (( proposed > MAX_CHILDREN_CAP )) && proposed=$MAX_CHILDREN_CAP
  if (( warnings < HOT_WARNINGS )) && (( $(percent_diff "$base" "$proposed") < CHANGE_PERCENT )); then proposed=$base; reason="$reason; below threshold"; fi
  requests=${BASE_REQUESTS[$key]}; (( requests == 0 || requests > MAX_REQUESTS_CAP )) && requests=$MAX_REQUESTS_CAP
  PROPOSED_CHILD[$key]=$proposed; PROPOSED_REQUESTS[$key]=$requests; REASON[$key]=$reason
  TOTAL_PROPOSED=$((TOTAL_PROPOSED + proposed))
  (( current != proposed || EFFECTIVE_REQUESTS[$key] != requests )) && CHANGES=$((CHANGES + 1))
  if (( proposed != base || requests != BASE_REQUESTS[$key] )); then
    DESIRED[$dir]+=$'\n['"$pool"$']\n; baseline pm.max_children = '"$base"$'\n; reason: '"$reason"$'\npm.max_children = '"$proposed"$'\npm.max_requests = '"$requests"$'\n'
  fi
done

log "PHP-FPM auto-optimizer $VERSION"
log "Memory: $MEMORY_MB MB; reserve: $RESERVED_MB MB; FPM budget: $FPM_BUDGET_MB MB"
log "Worker estimate: $WORKER_MB MB ($RSS_SOURCE); safe workers: $SAFE_CHILDREN; pools: ${#ACTIVE_KEYS[@]}"
log ""
printf '%-28s %8s %8s %8s %8s  %s\n' POOL BASELINE CURRENT NEW WARNINGS REASON
for key in "${ACTIVE_KEYS[@]}"; do
  pool=${key#*|}; printf '%-28s %8d %8d %8d %8d  %s\n' "$pool" "${BASE_CHILD[$key]}" "${EFFECTIVE_CHILD[$key]}" "${PROPOSED_CHILD[$key]}" "${WARNINGS[$pool]:-0}" "${REASON[$key]}"
done
log ""; log "Pools requiring an effective change: $CHANGES"

if (( TOTAL_PROPOSED > SAFE_CHILDREN * 2 )); then
  warn "aggregate recommendation ($TOTAL_PROPOSED) exceeds twice theoretical capacity ($SAFE_CHILDREN)"
  (( ! APPLY )) || die "refusing --apply because the global safety limit was exceeded"
fi
(( APPLY )) || { log "Dry run only. No configuration changes were made."; exit 0; }
(( EUID == 0 )) || die "--apply must be run as root"
(( CHANGES > 0 )) || { log "Nothing to apply."; exit 0; }
if (( ! ASSUME_YES )); then
  [[ -t 0 ]] || die "non-interactive apply requires --yes"
  read -r -p "Apply these settings and restart/reload PHP-FPM? [y/N] " answer
  [[ $answer =~ ^([yY]|yes|YES)$ ]] || die "cancelled"
fi

BACKUP_DIR="$BACKUP_ROOT/$RUN_ID"; mkdir -p "$BACKUP_DIR"
declare -a TOUCHED=(); declare -A BACKUP=() EXISTED=()
rollback() {
  local target
  warn "rolling back generated overrides"
  for target in "${TOUCHED[@]}"; do
    if [[ ${EXISTED[$target]} == 1 ]]; then cp -a "${BACKUP[$target]}" "$target"; else rm -f -- "$target"; fi
  done
}
for dir in "${FOUND_DIRS[@]}"; do
  target="$dir/zzz-auto-optimize.conf"; current_content=""; [[ -f $target ]] && current_content=$(<"$target")
  wanted="${DESIRED[$dir]:-}"
  if [[ -z $wanted && ! -e $target ]]; then continue; fi
  safe=${dir#/}; safe=${safe//\//_}; TOUCHED+=("$target")
  if [[ -e $target ]]; then EXISTED[$target]=1; BACKUP[$target]="$BACKUP_DIR/$safe.conf"; cp -a "$target" "${BACKUP[$target]}"; else EXISTED[$target]=0; fi
  if [[ -z $wanted ]]; then rm -f -- "$target"; continue; fi
  tmp=$(mktemp "$dir/.phpfpm-auto-optimize.XXXXXX") || { rollback; die "could not create temporary file"; }
  { printf '; Generated by %s %s on %s\n; Remove this file to restore baseline settings.\n' "$PROGRAM" "$VERSION" "$(date -Is)"; printf '%s' "$wanted"; } > "$tmp"
  chmod 0644 "$tmp"; mv "$tmp" "$target" || { rm -f -- "$tmp"; rollback; die "could not install $target"; }
done

declare -A VALIDATED=(); validation_failed=0
for dir in "${FOUND_DIRS[@]}"; do
  binary=""
  case $dir in
    /opt/cpanel/ea-php*/root/etc/php-fpm.d) root=${dir%/etc/php-fpm.d}; [[ -x $root/usr/sbin/php-fpm ]] && binary=$root/usr/sbin/php-fpm ;;
    /etc/php/*/fpm/pool.d) ver=${dir#/etc/php/}; ver=${ver%%/*}; command -v "php-fpm$ver" >/dev/null && binary=$(command -v "php-fpm$ver") ;;
    /etc/opt/remi/php*/php-fpm.d) root=${dir%/php-fpm.d}; [[ -x $root/sbin/php-fpm ]] && binary=$root/sbin/php-fpm ;;
    *) command -v php-fpm >/dev/null && binary=$(command -v php-fpm) ;;
  esac
  [[ -n $binary ]] || { warn "no validator for $dir"; validation_failed=1; continue; }
  [[ -z ${VALIDATED[$binary]:-} ]] || continue; VALIDATED[$binary]=1
  "$binary" -tt >/dev/null 2>&1 || { warn "validation failed: $binary -tt"; validation_failed=1; }
done
if (( validation_failed )); then rollback; die "validation failed; configuration restored; backups: $BACKUP_DIR"; fi

if [[ -x /scripts/restartsrv_apache_php_fpm ]]; then
  /scripts/restartsrv_apache_php_fpm || { rollback; /scripts/restartsrv_apache_php_fpm >/dev/null 2>&1 || :; die "cPanel restart failed; configuration restored"; }
elif command -v systemctl >/dev/null; then
  reloaded=0
  while read -r service; do
    systemctl is-active --quiet "$service" || continue
    systemctl reload "$service" || { rollback; die "reload failed for $service; configuration restored"; }
    reloaded=1
  done < <(systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '$1 ~ /(^php.*fpm|^ea-php.*-php-fpm)\.service$/ {print $1}')
  (( reloaded )) || warn "no active PHP-FPM service found; reload manually"
else warn "no supported service manager found; reload manually"
fi
log "Applied $CHANGES pool change(s). Backups: $BACKUP_DIR"
