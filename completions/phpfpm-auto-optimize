# shellcheck shell=bash
_phpfpm_auto_optimize() {
  local current=${COMP_WORDS[COMP_CWORD]}
  local options='--apply --yes --verbose --memory-mb --reserve-percent --target-percent --worker-mb --worker-percentile --lookback-hours --min-children --max-children --change-percent --max-requests --backup-retention --overcommit-percent --monitor-seconds --sample-interval --pool-dir --instance --log-file --backup-dir --config --check --json --no-reload --list-backups --restore --version --help'
  case ${COMP_WORDS[COMP_CWORD - 1]} in
    --pool-dir | --backup-dir)
      mapfile -t COMPREPLY < <(compgen -d -- "$current")
      return
      ;;
    --log-file | --config | --restore | --instance)
      mapfile -t COMPREPLY < <(compgen -f -- "$current")
      return
      ;;
  esac
  mapfile -t COMPREPLY < <(compgen -W "$options" -- "$current")
}
complete -F _phpfpm_auto_optimize phpfpm-auto-optimize
